---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/utils";
const title = "Jacks Pirate Life";
---

<Layout title={title}>
    <main
        id="main"
        class="relative w-full min-h-screen bg-cover bg-no-repeat bg-center"
        style={`background-image: url('${withBase("/images/limited-edt.webp")}'); font-family: 'Montserrat', sans-serif;`}
    >

        <div class="relative z-10 min-h-screen flex flex-col items-center justify-center px-6 py-20 bg-black/40">
            <!-- skull icon -->
            <header class="mb-12">
                <img src={withBase("/images/skullwhite_75x.webp")} alt="pirate skull" width="75" height="75" class="block mx-auto" />
            </header>

            <!-- hero content -->
            <section id="hero" class="w-full max-w-3xl text-center">
                <h1 class="text-white uppercase font-light tracking-tight text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-tight">
                    next drop : tba
                </h1>

                <div class="my-6 flex justify-center">
                    <hr class="w-12 border-gray-200/30" />
                </div>

                <p class="text-yellow-400 uppercase font-semibold tracking-wide mb-4">thanks everyone!!</p>

                <!-- subscribe form -->
                <form class="flex justify-center" action="#" method="post" aria-label="Subscribe for drops" onsubmit="event.preventDefault(); const email = this.querySelector('input').value; if (email) { alert(`Subscription successful! Thank you for subscribing with: ${email}`); this.reset(); }">
                    <label for="email" class="sr-only">Email address</label>
                    <div class="flex flex-col sm:flex-row w-full max-w-md gap-3">
                        <input
                            id="email"
                            name="email"
                            type="email"
                            required
                            placeholder="GET DROP NOTIFICATIONS"
                            class="px-4 py-3 border border-white bg-slate-800/80 placeholder-white/70 text-white focus:outline-none focus:ring-2 focus:ring-yellow-400 text-center sm:text-left text-sm flex-1"
                        />
                        <button
                            type="submit"
                            class="px-6 py-3 bg-yellow-400 hover:bg-yellow-300 text-neutral-900 font-bold uppercase tracking-wider transition duration-200 text-sm whitespace-nowrap"
                        >
                            Subscribe
                        </button>
                    </div>
                </form>

                <p class="text-yellow-400 uppercase font-semibold tracking-widest mt-8 text-sm sm:text-base">turn on ppl ig notifications</p>

                <div id="bottom" class="mt-8 text-white/90 uppercase tracking-wide">
                    <div class="text-base sm:text-lg">for customer service (mon-fri)</div>
                    <div class="mt-2 font-semibold text-sm sm:text-base">sales@jackspiratelife.com</div>
                </div>
            </section>
        </div>
    </main>
</Layout>
