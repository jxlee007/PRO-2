---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/utils";

const collabs = [
	{
		title: "pm ♦ theory 11",
		subtitle: "privacy playing cards",
		image: withBase("/images/collabs/collab-pg-1.webp"),
		href: "#",
	},
	{
		title: "pm X nomantic",
		subtitle: "camera bags",
		image: withBase("/images/collabs/collab-pg-2.webp"),
		href: "#",
	},
	{
		title: "pm X polar pro",
		subtitle: "premium lens filters",
		image: withBase("/images/collabs/collab-pg-3.webp"),
		href: "#",
	},
	{
		title: "pm X clocks + colours",
		subtitle: "premium lens filters",
		image: withBase("/images/collabs/collab-pg-4.webp"),
		href: "#",
	},
	{
		title: "pm X james coffee",
		subtitle: "signature coffee & merch",
		image: withBase("/images/collabs/collab-pg-5.webp"),
		href: "#",
	},
	{
		title: "pm X angels and airways",
		subtitle: "documentary coming-soon",
		image: withBase("/images/collabs/collab-pg-6.webp"),
		href: "#",
	},
	{
		title: "pm X royal\ncanadian mint",
		subtitle: "moraine lake coin",
		image: withBase("/images/collabs/collab-pg-7.webp"),
		href: "#",
	},
];
---

<Layout title="Collabs">
	<Nav logo={withBase("/images/digisign/ds1-black.webp")} />

	<main class="px-4 sm:px-8 py-4">
		<div class="max-w-6xl mx-auto">
			<h2
				class="text-center text-xl sm:text-2xl md:text-3xl font-normal tracking-wide uppercase mb-20"
			>
				Collabs
			</h2>

			<div class="space-y-10">
				{
					collabs.map((c) => (
						<article class="relative h-48 sm:h-64 md:h-72 lg:h-80 xl:h-96 overflow-hidden rounded-sm">
							<a href={c.href} class="block w-full h-full group">
								<img
									src={c.image}
									alt={c.title}
									class="w-full h-full object-cover brightness-75 group-hover:brightness-90 group-hover:scale-105 transition-all duration-700 ease-out"
								/>

								<div class="absolute inset-0 flex flex-col justify-center px-8 sm:px-16 md:px-24 bg-black/15 pointer-events-none">
									<h1 class="text-white font-extrabold uppercase text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl leading-tight drop-shadow-lg">
										{c.title.split("\n").map((s, i) => (
											<span class="block">{s}</span>
										))}
									</h1>
									<p class="text-white/90 uppercase text-xs sm:text-sm md:text-base font-light tracking-widest mt-2 drop-shadow-sm">
										{c.subtitle}
									</p>
								</div>
							</a>
						</article>
					))
				}
			</div>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	/* small fade-in for the page */
	main {
		animation: fadeIn 700ms ease-in-out both;
	}
	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
</style>
