---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { products } from "./shop/products.js";
import { withBase } from "../lib/utils";

---

<Layout title="Shop - All Products">
    <Nav logo="/images/digisign/ds1-black.webp" />
    <main class="px-4 sm:px-8 py-4">
    <div class="max-w-7xl mx-auto space-y-8">
      {products.map((product) => (
        <div class="relative flex justify-center py-4">
          <a 
            href={withBase(`/shop/${product.slug}`)}
            target={product.target || "_self"}
            rel={product.target ? "noopener noreferrer" : undefined}
            class="relative block w-full max-w-6xl h-48 sm:h-64 md:h-72 lg:h-80 xl:h-96 overflow-hidden rounded-sm group"
          >
            <img 
              src={withBase(product.image)} 
              alt={product.title}
              class="w-full h-full object-cover brightness-75 group-hover:brightness-90 group-hover:scale-105 transition-all duration-700 ease-out"
            />
            
            <!-- Text overlay -->
            <div class="absolute inset-0 flex flex-col justify-center px-8 sm:px-16 md:px-24 bg-black/15 pointer-events-none">
              <h1 class="text-white font-extrabold uppercase text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl leading-tight drop-shadow-md">
                {product.title}
              </h1>
              {product.subtitle ? (
                <h5 class="text-white/90 uppercase text-xs sm:text-sm md:text-base font-light tracking-widest mt-2 drop-shadow-sm">
                  {product.subtitle}
                </h5>
              ) : null}
            </div>
          </a>
        </div>
      ))}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Fade-in animation for page load */
  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  
  main {
    animation: fadeIn 1s ease-in-out forwards;
  }
</style>
