---
// Gallery.astro - an interactive Astro island (initialization runs on client)
// Props: images: Array<{src:string, thumb:string, alt?:string}>
import { withBase } from '../lib/utils';
const uid = Math.random().toString(36).slice(2, 9);
export interface Props {
  images?: { src: string; thumb?: string; alt?: string }[];
}
export const imagesDefault = [
  {
    src: '/images/thumb-gallery/ford-gt/ford-gt-pm800.webp',
    thumb: '/images/thumb-gallery/ford-gt/ford-gt-pm800%20small.webp',
    alt: 'Ford GT sunset print in frame',
  },
  {
    src: '/images/thumb-gallery/ford-gt/fordgt-wideall.webp',
    thumb: '/images/thumb-gallery/ford-gt/fordgt-wideall%20small.webp',
    alt: 'Ford GT triptych displayed on wall',
  },
  {
    src: '/images/thumb-gallery/ford-gt/fordgt-cularge-solo.webp',
    thumb: '/images/thumb-gallery/ford-gt/fordgt-cusmall-solo.webp',
    alt: 'Ford GT large format detail',
  },
  {
    src: '/images/thumb-gallery/ford-gt/fordgt-cumed-solo.webp',
    thumb: '/images/thumb-gallery/ford-gt/fordgt-cumed-solo%20small.webp',
    alt: 'Ford GT medium crop print detail',
  },
  {
    src: '/images/thumb-gallery/ford-gt/fordgt-widelarge-solo.webp',
    thumb: '/images/thumb-gallery/ford-gt/fordgt-widelarge-solo%20small.webp',
    alt: 'Ford GT wide angle hero shot print',
  },
];

const { images = imagesDefault } = Astro.props as Props & { images?: typeof imagesDefault };
---

<div id={`gallery-${uid}`} class="gallery-island max-w-5xl mx-auto">
  <div class="flex flex-col md:flex-row gap-6 items-start">
    <!-- Right: text / details slot (optional) -->
    <div class="order-1 w-full md:w-1/2 md:pr-8">
      <slot name="meta">
        <!-- default metadata slot left empty so consumer can provide content -->
      </slot>
    </div>

    <!-- Left: sliders -->
    <div class="order-2 mt-6 w-full md:mt-0 md:w-1/2">
      <div class="relative">
        <div class="swiper mySwiper2 overflow-hidden bg-gray-900/5">
          <div class="swiper-wrapper">
            {images.map((img) => (
              <div class="swiper-slide flex items-center justify-center bg-gray-100">
                <img src={withBase(img.src)} alt={img.alt ?? ''} class="object-contain w-full h-[40vh] md:h-[50vh]" />
              </div>
            ))}
          </div>

          <button class="swiper-button-next text-white/90"></button>
          <button class="swiper-button-prev text-white/90"></button>
        </div>

        <div thumbsSlider="" class="mt-4 swiper mySwiper overflow-hidden">
          <div class="swiper-wrapper">
            {images.map((img) => (
              <div class="swiper-slide cursor-pointer overflow-hidden">
                <img src={withBase(img.thumb ?? img.src)} alt={img.alt ?? ''} class="w-full h-16 object-cover" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .mySwiper .swiper-slide {
    opacity: 0.4;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    cursor: pointer;
  }
  .mySwiper .swiper-slide-thumb-active {
    opacity: 1;
    border: 2px solid #000;
  }
</style>